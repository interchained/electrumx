COIN=Bitcoin
NET=mainnet
ALLOW_ROOT=true
SSL_CERTFILE=/root/.electrumx/server.crt
SSL_KEYFILE=/root/.electrumx/server.key
DB_DIRECTORY=/root/.electrumx/db
DAEMON_URL=http://interchainrpc:supersecure@127.0.0.1:8332
MAX_SESSIONS=200000
REQUEST_TIMEOUT=2400
DB_ENGINE=leveldb
CACHE_MB=4096
BATCH_SIZE=1000
PRUNE_HISTORY=0
COST_SOFT_LIMIT=1000000000
COST_HARD_LIMIT=2000000000
SESSION_COST_SOFT_LIMIT=1000000000
SESSION_COST_HARD_LIMIT=2000000000
BANDWIDTH_SOFT_LIMIT=1000000000
BANDWIDTH_HARD_LIMIT=2000000000
GROUP_SOFT_LIMIT=1000000000
GROUP_HARD_LIMIT=2000000000
COST_LIMIT=2000000000
MAX_CONCURRENT=5000
GROUP_INTERVAL=3600
INITIAL_CONCURRENT=5000
SESSION_TIMEOUT=1800
MAX_SEND=100000000
